# Copy this file to .env and adjust. Never commit the real .env.

# HTTP port the server listens on
PORT=3000

# "development" or "production". In production JWT_SECRET is mandatory.
NODE_ENV=development

# SQLite database file (created automatically, including the folder)
DATABASE_PATH=./data/gym.db

# Secret used to sign login tokens. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# How long a login stays valid (jsonwebtoken format: 12h, 7d, ...)
JWT_EXPIRES_IN=12h

# Branding shown in the UI
GYM_NAME=Aurelian Athletic Society

# IANA timezone the gym operates in. Decides when a membership "day" starts and ends.
GYM_TIMEZONE=Asia/Kolkata

# ISO 4217 currency code used to display plan prices
CURRENCY=INR

# Members may book or cancel up to this many minutes before a class starts
BOOKING_CUTOFF_MINUTES=120

# Send a membership expiry reminder this many days ahead (first reminder);
# a final reminder is always sent at 1 day.
REMINDER_DAYS=7
